{
  "$schema": "node_modules/wrangler/config-schema.json",
  // OpenNext's app plus a scheduled handler (due date reminders).
  "main": "custom-worker.ts",
  "name": "zawyh",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "zawyh"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zawyh-db",
      "database_id": "d998695b-3bdb-47c7-8ba5-4cbf01bcd410",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI, for the Cloudflare translation options (Platform → Settings).
  // Always remote (real Cloudflare, real usage), even under `next dev`.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // No per-deployment vars: the app's address, email, the Google client and
  // the push keys are set in Platform → Settings. The one secret is
  // ENCRYPTION_KEY (`wrangler secret put ENCRYPTION_KEY`, see .dev.vars.example).

  // Hourly: each person gets reminders at 08:00 in their own time zone.
  // Every 5 minutes: Google sync (poll Google Tasks, retries, channel renewal).
  "triggers": {
    "crons": ["0 * * * *", "*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
