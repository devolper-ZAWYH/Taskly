{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taskly",
  "version": "0.1.0",
  "identifier": "com.zawyh.taskly",
  "build": {
    "devUrl": "http://localhost:3100",
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Taskly desktop app",
    "longDescription": "Taskly desktop app: embeds the existing Taskly web UI in a desktop window with tray controls, and hosts the local meeting capture engine in later phases.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["taskly"]
      }
    }
  }
}
