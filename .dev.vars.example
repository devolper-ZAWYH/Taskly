# Copy to .dev.vars for local development (wrangler and `next dev` read it).
NEXTJS_ENV=development

# The one secret every deployment sets (`wrangler secret put ENCRYPTION_KEY`):
# encrypts Google tokens and the secrets saved in Platform → Settings.
# 32 random bytes, base64. Set it once and never change it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Everything below is optional: operators set it in Platform → Settings, which
# overrides these per group. Values here are a fallback (handy locally).

# The app's public address (links in emails and Google items; webhooks need https).
APP_ORIGIN=http://localhost:3100

# Web push key pair (Platform → Settings can generate one).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google sync (docs/plan-google-sync.md): an OAuth client of type "Web application"
# with redirect URI http://localhost:3100/api/google/callback (and the live one).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email through the cPanel mailbox: implicit TLS on port 465 (the app won't
# send a password to a remote server without TLS).
#   SMTP_HOST=mail.zawyh.com  SMTP_PORT=465  SMTP_USER=noreply@zawyh.com
#   SMTP_PASS=<mailbox password>  MAIL_FROM=Taskly <noreply@zawyh.com>
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Arabic ↔ English translation of meeting titles and agendas. Provider: azure,
# google, deepl, amazon, cloudflare_llm, cloudflare_m2m100 or anthropic.
# TRANSLATE_KEY is the API key (Amazon: secret access key); TRANSLATE_KEY_ID is
# Amazon's access key ID; TRANSLATE_REGION is Azure's (optional) or Amazon's;
# TRANSLATE_MODEL overrides the model for cloudflare_llm / anthropic.
TRANSLATE_PROVIDER=
TRANSLATE_KEY=
TRANSLATE_KEY_ID=
TRANSLATE_REGION=
TRANSLATE_MODEL=

# Testing only: mock servers instead of Google (scripts/google-mock.mjs), the
# mail server (scripts/smtp-mock.mjs: SMTP_HOST=localhost, SMTP_PORT=2525,
# SMTP_SECURE=false) and the translation services (scripts/translate-mock.mjs).
GOOGLE_API_ORIGIN=
GOOGLE_OAUTH_ORIGIN=
TRANSLATE_API_ORIGIN=
